---
const code = Astro.url.searchParams.get("code") ?? "500";
const error = Astro.url.searchParams.get("error") ?? "Unknown Error";
const context = Astro.url.searchParams.get("context") ?? "Unspecified error";
Astro.response.status = Number(code);
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{error}</title>
</head>
<body>
<main>

    <h1><span class="code">{code}</span>: {error}</h1>

    <p class="path"><code>{context}</code></p>
</main>

<style>
    html,
    body {
        margin: 0;
        height: 100%;
    }

    body {
        background: #17171a;
        color: #f5f5f7;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
    }

    main {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        text-align: center;
    }

    h1 {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 700;
    }

    .code {
        color: #c9a3ff;
    }

    .path {
        margin: 0;
        padding: 0.5rem 1rem;
        border: 1px solid #2e2e33;
        border-radius: 6px;
        font-size: 0.9rem;
    }

    .path span {
        color: #9a9aa2;
        margin-right: 0.3em;
    }

    code {
        font-family: Consolas, Menlo, monospace;
    }
</style>
</body>
</html>