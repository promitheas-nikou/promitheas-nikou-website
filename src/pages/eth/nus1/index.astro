---
import * as Images from '../images.ts';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FileLink from '../../../components/FileLink.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';
---

<!doctype html>
<html lang="en">
<head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
        main {
            width: 960px;
        }
        ul {
            display: flex;
            flex-wrap: wrap;
            gap: 2rem;
            list-style-type: none;
            margin: 0;
            padding: 0;
        }
        ul li {
            width: calc(50% - 1rem);
        }
        ul li * {
            text-decoration: none;
            transition: 0.2s ease;
        }
        //ul li:first-child {
        //    width: 100%;
        //    margin-bottom: 1rem;
        //    text-align: center;
        //}
        //ul li:first-child img {
        //    width: 100%;
        //}
        //ul li:first-child .title {
        //    font-size: 2.369rem;
        //}
        ul li img {
            margin-bottom: 0.5rem;
            border-radius: 12px;
        }
        ul li a {
            display: block;
        }
        .title {
            margin: 0;
            color: rgb(var(--black));
            line-height: 1;
        }
        .date {
            margin: 0;
            color: rgb(var(--gray));
        }
        ul li a:hover h4,
        ul li a:hover h5,
        ul li a:hover .date {
            color: rgb(var(--accent));
        }
        ul a:hover img {
            box-shadow: var(--box-shadow);
        }
        @media (max-width: 720px) {
            ul {
                gap: 0.5em;
            }
            ul li {
                width: 100%;
                text-align: center;
            }
            ul li:first-child {
                margin-bottom: 0;
            }
            ul li:first-child .title {
                font-size: 1.563em;
            }
        }
        /* Container styling to ensure the table doesn't overflow */
        table {
            width: 100%;
            border-collapse: collapse; /* Merges borders so you get clean, single outlines */
            margin: 20px 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 16px;
            text-align: left;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
            border-radius: 8px;
            overflow: hidden; /* Keeps the rounded corners clean */
            border: 1px solid #e0e0e0;
        }

        /* Header Styling */
        thead {
            background-color: #e1e5ff; /* Modern blue accent */
            color: #000000;
            font-weight: 600;
        }

        /* Row and Cell Outlines */
        th, td {
            padding: 12px 16px;
            border: 1px solid #e0e0e0; /* The outline for entries */
            vertical-align: middle;
        }

        /* Subtle styling specifically for headers if you decide to change <td> to <th> later */
        thead td, thead th {
            font-weight: bold;
            border-bottom: 2px solid #3352ce;
        }

        /* Alternating row colors for better readability */
        tbody tr:nth-child(even) {
            background-color: #f8f9fa;
        }

        /* Hover effect to highlight the current row */
        tbody tr:hover {
            background-color: #f1f3f9;
            transition: background-color 0.2s ease;
        }

        /* Styling for your custom FileLink / links inside the table */
        table a, table td * {
            color: #4a6cf7;
            text-decoration: none;
            font-weight: 500;
        }

        table a:hover, table td *:hover {
            text-decoration: underline;
            color: #2b4cd2;
        }
    </style>
</head>
<body>
<Header />
<main>
    <section>
        <h4><a href="/eth">&lt; See all subjects</a></h4>
        <h2>Netzwerke und Schaltunge 1<br/>Prof. Christian Franck</h2>
        <h4>D-ITET Sem 1 (Herbstsemester 2026)</h4>
        <p style="font-size: 1.5em">Every Thursday/Jede Donnerstag, <a href="https://maps.app.goo.gl/mDDMakCVwzN89YPCA">IFW A34</a>, 10:15-12:00</p>
    </section>
    <br/>
    <section>
        <Image width={500} height={255} src={Images.nus1image} alt={"Plasma Ball"}/>
        <h2>Course Information</h2>
        <p>Albach ISBN: 978-3-86894-398-6</p>
        <p>Albach Online: <a href="https://elibrary.pearson.de/book/99.150005/9783863268947">https://elibrary.pearson.de/book/99.150005/9783863268947</a></p>
        <br/>
        <h2>Feedback and Q&amp;A</h2>
        <p>I would love to hear your thoughts about the class, the subject or life at the ETH, and I'd especially love some feedback!</p>
        <p>Here you can anonymously ask a question or give some feedback and have me explain in the Übungstunde or in private! Of course contact by email is also fine if you prefer that!</p>
        <p>Ask a question: <a href="https://docs.google.com/forms/d/e/1FAIpQLSdmpYhDOh3WdOHDxe_oP-eKUWVV86FGhQP4dFOAp7g9kTKWAw/viewform">Q&amp;A Form</a></p>
        <p>Submit feedback: <a href="https://docs.google.com/forms/d/e/1FAIpQLSf4NaLDFen4UgxMs6QBG8rW8goVJfTXMqSxh-OPWxepFCYBog/viewform">Feedback Form</a></p>
        <table>
            <thead>
                <tr>
                    <th>Week</th>
                    <th>Slides</th>
                    <th>Documents</th>
                </tr>
            </thead>
            <tbody>
            <tr>
                <td>Week 1</td>
                <td><FileLink file="/eth-files/2026H-NuS1/slides/W1.odp" download_as="NuS1 Slides W1.odp" label="My Slides 1 (ODP)"/><br/>
                    <FileLink file="/eth-files/2026H-NuS1/slides/ETH-W1.pptx" download_as="ETH Official NuS1 Slides W1.pptx" label="ETH Slides 1 (PPTX)"/></td>
                <td><FileLink file="/eth-files/2026H-NuS1/notes/W1.odt" download_as="NuS1 Notes W1.odt" label="Notes 1 (ODT)"/><br/></td>
            </tr>
            </tbody>
        </table>
    </section>
</main>
<Footer />
</body>
</html>
